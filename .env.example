# AutoPath Frontend Environment Variables (.env.example)
# Copy to .env and configure for your environment

# ---- External Backend API Configuration ----
# The backend repository is developed separately and serves as the source of truth for:
# - Auto stands
# - Route details (start stop, destination stop, ordered intermediate stops)
# - Complete ordered road-network path coordinates
VITE_API_BASE_URL=http://localhost:5000/api

# Set to 'false' to connect to the live backend server.
# When 'true', uses the development mock adapter without making external network calls.
VITE_USE_MOCK_DATA=true

# API request timeout in milliseconds
VITE_API_TIMEOUT_MS=8000

# ---- Google Maps API Key (Optional for MapView tile layer) ----
# Create one at https://console.cloud.google.com/apis/credentials
# Restrict to: Maps JavaScript API, HTTP Referrers (localhost:5173, your domain)
# If left blank, the frontend automatically falls back to CartoDB Voyager tiles.
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
